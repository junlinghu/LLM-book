   "source": [
    "# A.3: UTF-8 bytes\n",
    "\n",
    "Show the UTF-8 encoding of characters from different scripts.\n"
   ]
  },
  {
   "cell_type": "code",
   "id": "8c5806f9b99e",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "for ch in [\"a\", \"é\", \"你\", \"🙂\"]:\n",
    "    print(ch, list(ch.encode(\"utf-8\")))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "75f39a46d093",
   "metadata": {},
   "source": [
    "**Expected output**\n",
    "\n",
    "Output:\n",
    "\n",
    "```text\n",
    "a [97]\n",
    "é [195, 169]\n",
    "你 [228, 189, 160]\n",
    "🙂 [240, 159, 153, 130]\n",
    "```\n"
   ]
  }
 ]
